model Service {
  id          String  @id @default(uuid())
  name        String  @db.VarChar(150)
  slug        String  @unique @db.VarChar(120)
  description String?

  // Price for one offline/home session
  price Decimal @db.Decimal(10, 2)

  // Number of sessions included
  sessions Int

  // Controls whether the service is available for purchase
  status ServiceStatus @default(ACTIVE)

  imageUrl String? @db.VarChar(500)
  imagePublicId String? @db.VarChar(255)

  trainerId String?
  trainer User? @relation("TrainerServices", fields: [trainerId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  bookings ServiceBooking[]

  @@index([status])
  @@index([createdAt])
  @@index([price])
  @@index([trainerId])
}

enum ServiceStatus {
  ACTIVE
  INACTIVE
}
