model User {
  id String @id @default(uuid())

  name  String  @db.VarChar(100)
  email String  @unique @db.VarChar(255)
  phone String? @db.VarChar(20)

  // Authentication
  password String?

  role UserRole @default(USER)

  // Trainer/public profile
  profileUrl           String? @db.VarChar(500)
  aboutMe             String? @db.VarChar(2000)
  experience          String? @db.VarChar(100)
  specialty           String? @db.VarChar(150)
  profileImageUrl      String? @db.VarChar(500)
  profileImagePublicId String? @db.VarChar(255)

  // Customer address
  address1   String?
  address2   String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  trainerServices Service[] @relation("TrainerServices")
  trainerBookings ServiceBooking[] @relation("TrainerBookings")
  customerBookings ServiceBooking[] @relation("CustomerBookings")

  @@index([name])
  @@index([phone])
  @@index([createdAt])
}

enum UserRole {
  USER
  TRAINER
  ADMIN
}
