model User {
  id String @id @default(uuid())

  name  String  @db.VarChar(100)
  email String  @unique @db.VarChar(255)
  phone String? @db.VarChar(20)

  // Authentication
  password String?

  role UserRole @default(USER)

  // Customer address
  address1   String?
  address2   String?
  city       String?
  state      String?
  country    String?
  postalCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([name])
  @@index([phone])
  @@index([createdAt])
}

enum UserRole {
  USER
  ADMIN
}
