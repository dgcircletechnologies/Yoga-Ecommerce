model Order {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status OrderStatus @default(PENDING)

  // Order totals
  subtotal Decimal @db.Decimal(10, 2)
  discount Decimal @default(0) @db.Decimal(10, 2)
  shippingCharge Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  // Customer/shipping address snapshot
  name       String  @db.VarChar(100)
  email      String  @db.VarChar(255)
  phone      String? @db.VarChar(20)
  address    String
  city       String
  state      String
  country    String
  postalCode String

  items   OrderItem[]
  payment Payment?
  serviceBooking ServiceBooking?
  history OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model ServiceBooking {
  id String @id @default(uuid())
  orderId String @unique
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  serviceId String
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  trainerId String
  trainer User @relation("TrainerBookings", fields: [trainerId], references: [id], onDelete: Restrict)
  customerId String
  customer User @relation("CustomerBookings", fields: [customerId], references: [id], onDelete: Restrict)
  quantity Int
  pricePerSession Decimal @db.Decimal(10, 2)
  totalAmount Decimal @db.Decimal(10, 2)
  status ServiceBookingStatus @default(PENDING_PAYMENT)
  address String
  city String
  state String
  country String
  postalCode String
  otpHash String?
  otp String?
  otpEncrypted String?
  otpExpiresAt DateTime?
  otpVerifiedAt DateTime?
  otpAttempts Int @default(0)
  otpBlockedUntil DateTime?
  verifiedBy String?
  sceneImages Json @default("[]")
  imageReviewStatus ServiceBookingImageReviewStatus @default(NOT_UPLOADED)
  imageReviewedAt DateTime?
  imageReviewedBy String?
  imageRejectionReason String?
  adminReviewStatus ServiceBookingAdminReviewStatus @default(PENDING)
  adminReviewedAt DateTime?
  adminReviewedBy String?
  adminRejectionReason String?
  actions ServiceBookingAction[]
  sessions ServiceSession[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainerId, status])
  @@index([customerId, createdAt])
  @@index([serviceId])
}

model ServiceBookingAction {
  id String @id @default(uuid())
  bookingId String
  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  action String
  performedBy String?
  actorType ServiceBookingActorType
  description String
  metadata Json?
  performedAt DateTime @default(now())

  @@index([bookingId, performedAt])
}

enum ServiceBookingImageReviewStatus {
  NOT_UPLOADED
  PENDING
  REVIEWED
  REJECTED
}

enum ServiceBookingAdminReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ServiceBookingActorType {
  SYSTEM
  CUSTOMER
  TRAINER
  ADMIN
}

model ServiceSession {
  id String @id @default(uuid())
  bookingId String
  booking ServiceBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  scheduledAt DateTime
  status ServiceSessionStatus @default(SCHEDULED)
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, scheduledAt])
  @@index([scheduledAt])
  @@index([bookingId, status])
}

enum ServiceBookingStatus {
  PENDING_PAYMENT
  PENDING
  CONFIRMED
  PAID
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ServiceSessionStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // One of these will be set depending on item type
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  serviceId String?
  service   Service? @relation(fields: [serviceId], references: [id])

  type OrderItemType

  // Snapshot of purchased item
  name     String  @db.VarChar(150)
  price    Decimal @db.Decimal(10, 2)
  quantity Int     @default(1)
  discount Decimal @default(0) @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([serviceId])
  @@index([type])
}

enum OrderItemType {
  PRODUCT
  SERVICE
}

enum OrderStatus {
  NEW
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
}

model OrderStatusHistory {
  id String @id @default(uuid())
  orderId String
  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  previousStatus OrderStatus?
  newStatus OrderStatus
  changedBy String?
  actorType OrderHistoryActorType
  reason String?
  metadata Json?
  changedAt DateTime @default(now())

  @@index([orderId, changedAt])
}

enum OrderHistoryActorType {
  SYSTEM
  CUSTOMER
  ADMIN
}
